{
    "federated": {
        "num_clients": 10,
        "join_ratio": 0.5,
        "dataset": "small",
        "global_rounds": 12
    },
    "smart_contract": {
        "enabled": true,
        "aggregation_method": "fedavg",
        "min_clients_ratio": 0.5,
        "max_clients": null,
        "description": "智能合约聚合配置: enabled=true启用智能合约, aggregation_method可选fedavg/weighted_avg/median/krum"
    },
    "decentralized": {
        "p2p_enabled": true,
        "p2p_mode": "local",
        "broadcast_timeout": 2.0,
        "auto_publish": true
    },
    "blockchain_storage": {
        "enabled": true,
        "lightweight": true,
        "disk_storage": false,
        "keep_recent_blocks": 3,
        "storage_dir": "blockchain_storage",
        "storage_mode": "summary",
        "circular_mode": true,
        "circular_length": null
    },
    "attack": {
        "enabled": false,
        "start_round": 5,
        "num_malicious": 3,
        "malicious_ids": [0, 3, 7],
        "verbose": true,
        "data_poisoning": {
            "enabled": true,
            "strategy": "label_flip",
            "poison_ratio": 0.3,
            "target_label": 5,
            "flip_to_label": 12,
            "noise_std": 0.01,
            "trigger_offset": 0.0
        },
        "model_poisoning": {
            "enabled": true,
            "strategy": "scaling",
            "scaling_factor": 1.2,
            "noise_std": 0.0
        }
    },
    "npc_deputy": {
        "enabled": true,
        "num_deputies": 3,
        "initial_stake": 100.0,
        "random_init_stake": true,
        "stake_range_min": 50.0,
        "stake_range_max": 150.0,
        "similarity_threshold": 0.3,
        "similarity_weight": 0.7,
        "stake_weight": 0.3,
        "reward_factor": 0.1,
        "penalty_factor": 0.05,
        "malicious_penalty_factor": 0.2,
        "deputy_performance_weight": 0.6,
        "deputy_stake_weight": 0.4,
        "deputy_max_tenure": 5,
        "deputy_block_reward": 5.0,
        "deputy_storage_reward_ratio": 0.3,
        "deputy_validation_failure_threshold": 3,
        "deputy_failure_penalty": 2.0,
        "deputy_slash_threshold": 0.5,
        "deputy_slash_ratio": 0.1,
        "keep_recent_rounds": 5,
        "gradient_storage_dir": "blockchain_gradient_storage",
        "description": "NPC Deputy机制配置（DPOS超级节点）: enabled=true启用NPC deputy, num_deputies为deputy数量(M), random_init_stake=true随机初始化权益, similarity_threshold为相似度阈值（低于此值的视为恶意梯度）, deputy_performance_weight和deputy_stake_weight用于综合选择下一轮deputy, deputy_max_tenure为最大连续任期（防止长期垄断）, deputy_block_reward为出块奖励, deputy_validation_failure_threshold为验证失败次数阈值, deputy_failure_penalty为失职惩罚金额, deputy_slash_ratio为Slashing惩罚比例, keep_recent_rounds为内存中保留的最近轮次数（默认5轮，超过的保存到本地）, gradient_storage_dir为梯度存储目录"
    }
}

